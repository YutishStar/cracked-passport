# ── Demo mode ────────────────────────────────────────────────────
# Skips Clerk sign-in entirely — every route is reachable with no auth, all
# under one fixed fake identity. Local demos only, never in production.
NEXT_PUBLIC_DEMO_MODE=false

# ── Clerk (auth) ───────────────────────────────────────────────
# Create an app at dashboard.clerk.com, enable Google as a social provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# ── Supabase (database + storage) ──────────────────────────────
# Only the service-role key is used (server-side). No anon key needed.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# ── Resend (email) ─────────────────────────────────────────────
# TESTING: use onboarding@resend.dev as the from-address — it works with no
# domain setup, but Resend will only deliver to YOUR OWN Resend-account email.
#   EMAIL_FROM=Cracked <onboarding@resend.dev>
# PRODUCTION: verify crackedhq.com in Resend (add its SPF+DKIM DNS records),
# then switch to passport@crackedhq.com to email anyone.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Cracked <onboarding@resend.dev>

# ── Pinata (IPFS metadata) ─────────────────────────────────────
PINATA_JWT=xxx
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

# ── Chain (Avalanche) ──────────────────────────────────────────
# stub  = no chain, passports marked 'deferred' (works with zero chain setup)
# fuji  = Avalanche Fuji testnet
# avalanche = mainnet (flip only when ready)
CHAIN_MODE=stub
NEXT_PUBLIC_CHAIN_ID=43113
PASSPORT_CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
CERTIFICATES_CONTRACT_ADDRESS=

# ── Sign in with Core (wallet-based login for returning Fellows) ──
# Any long random string — signs the wallet-session cookie. Generate with:
#   openssl rand -base64 32
WALLET_SESSION_SECRET=

# ── App ────────────────────────────────────────────────────────
# Admins are identified by their verified email. Comma-separated.
ADMIN_EMAILS=you@email.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Analytics (existing PostHog project 447944) ────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
